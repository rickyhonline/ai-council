# Server-only model credentials. Do not prefix with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
# Optional: an exact provider/model ID from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
# Durable local directory; defaults to .council in this checkout.
# COUNCIL_DATA_DIR=/absolute/path/to/your/council-data

# High-quality stock voice output; kept server-side.
ELEVENLABS_API_KEY=
# Direct OpenAI key may be used by the runtime chosen after architecture review.
# OPENAI_API_KEY=
